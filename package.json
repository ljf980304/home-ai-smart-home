  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "typescript-eslint": "^8.68.0"
  }
}
